{
"$schema": "http://json-schema.org/draft-07/schema#",
"$id": "https://localhost:3000",
"title": "Države i gradovi",
"description": "Baza podataka o državama i gradovima za otvoreno računarstvo.",
"type": "array",
"items": {
        "type": "object",
        "required": [
                "id",
                "country",
                "iso_code",
                "continent",
                "currency",
                "currency_code",
                "cities"
        ],
        "properties": {
                "id": {
                        "type": "number"
                },
                "country": {
                        "type": "string"
                },
                "country_population": {
                        "type": "number"
                },
                "area": {
                        "type": "number"
                },
                "iso_code": {
                        "type": "string"
                },
                "continent": {
                        "type": "string"
                },
                "currency": {
                        "type": "string"
                },
                "currency_code": {
                        "type": "string"
                },
                "cities": {
                        "type": "array",
                                "items": {
                                "type": "object",
                                "properties": {
                                        "city": {
                                                "type": "string"
                                        },
                                        "postal_code": {
                                                "type": "string"
                                        }
                                },
                        "required": ["city"]
                        }
                }
        }
}
}